<Window x:Class="ImageTextDetector.InsightFaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InsightFace (ArcFace) — Reconhecimento e Fotos Repetidas"
        Height="860" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" MinHeight="700" MinWidth="820">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔬 InsightFace — ArcFace (512-d)" FontSize="22" FontWeight="Bold"
                   Foreground="#333333" Margin="20,15,20,10"/>

        <TabControl Grid.Row="1" Margin="15,0,15,15" Background="White">

            <!-- ══════════════════ ABA 1: RECONHECIMENTO ══════════════════ -->
            <TabItem Header="Reconhecimento (ArcFace)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <GroupBox Header="👤 Referência do Rosto (foto ou pasta com várias fotos)" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Caminho:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="RefTextBox" Height="30" Padding="8" Width="560" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Foto..." Width="72" Height="30" Margin="0,0,6,0" Click="BrowseRefFile_Click" Background="#9C27B0" Foreground="White" FontWeight="Bold"/>
                                    <Button Content="Pasta..." Width="72" Height="30" Click="BrowseRefFolder_Click" Background="#7B1FA2" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Similaridade mínima:" VerticalAlignment="Center" Width="140" Foreground="#666666"/>
                                    <Slider x:Name="SimSlider" Minimum="0.30" Maximum="0.60" Value="0.42" TickFrequency="0.01"
                                            IsSnapToTickEnabled="True" Width="280" VerticalAlignment="Center"
                                            ValueChanged="SimSlider_ValueChanged"/>
                                    <TextBlock x:Name="SimLabel" Text="0.42" VerticalAlignment="Center" Margin="10,0,0,0" Width="40" FontWeight="Bold"/>
                                    <TextBlock Text="(maior = mais rigoroso)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#999999" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="📁 Pastas de Origem" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Local 1:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="Src1TextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseSrc1_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Local 2:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="Src2TextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseSrc2_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Local 3:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="Src3TextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseSrc3_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="📁 Destinos" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Alvo:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="OutTextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseOut_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Outro:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="OtherTextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseOther_Click" Background="#E91E63" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sem rosto:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                    <TextBox x:Name="NoFaceTextBox" Height="30" Padding="8" Width="640" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Procurar..." Width="90" Height="30" Click="BrowseNoFace_Click" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="📊 Progresso" Padding="12" Margin="0,0,0,12">
                            <TextBox x:Name="RecProgressTextBox" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="8" FontFamily="Consolas" FontSize="10" IsReadOnly="True"/>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="RecProcessButton" Content="▶ Reconhecer e Organizar" Width="240" Height="46" Margin="5"
                                    Click="RecProcess_Click" Background="#2196F3" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ ABA 2: FOTOS REPETIDAS ══════════════════ -->
            <TabItem Header="Fotos Repetidas">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="📂 Pasta a analisar" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Pasta:" VerticalAlignment="Center" Width="70" Foreground="#666666"/>
                                <TextBox x:Name="DupFolderTextBox" Height="30" Padding="8" Width="620" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="Procurar..." Width="90" Height="30" Click="BrowseDupFolder_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="DupRecursiveCheck" Content="Incluir subpastas" IsChecked="True" VerticalAlignment="Center" Margin="70,0,20,0"/>
                                <TextBlock Text="Similaridade:" VerticalAlignment="Center" Foreground="#666666"/>
                                <Slider x:Name="DupSimSlider" Minimum="0.35" Maximum="0.95" Value="0.50" TickFrequency="0.01"
                                        IsSnapToTickEnabled="True" Width="240" VerticalAlignment="Center" Margin="8,0,0,0"
                                        ValueChanged="DupSimSlider_ValueChanged"/>
                                <TextBlock x:Name="DupSimLabel" Text="0.50" VerticalAlignment="Center" Margin="10,0,0,0" Width="40" FontWeight="Bold"/>
                                <TextBlock Text="(0.50 = mesma pessoa · 0.80+ = quase idênticas)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#999999" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DupAnalyzeButton" Content="🔍 Analisar" Width="140" Height="38" Margin="0,0,8,0"
                                Click="DupAnalyze_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="DupMoveButton" Content="📦 Mover repetidas (manter 1 de cada)..." Width="300" Height="38"
                                Click="DupMove_Click" Background="#FF5722" Foreground="White" FontWeight="Bold" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" x:Name="DupStatusLabel" Text="" Margin="2,0,0,8" Foreground="#555555" FontWeight="Bold"/>

                    <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" Background="White">
                        <ListBox x:Name="DupGroupsList" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="#333333">
                                                <Run Text="Grupo"/><Run Text=" "/><Run Text="{Binding Count}"/><Run Text=" fotos · similaridade "/><Run Text="{Binding AvgSimilarityText}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#666666" Margin="12,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBox Grid.Row="4" x:Name="DupProgressTextBox" Height="70" Margin="0,8,0,0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" FontSize="10" IsReadOnly="True"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
